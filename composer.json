{
    "name": "accredifysg/singpass-login",
    "description": "A Laravel package for integrating SingPass Login and MyInfo",
    "type": "laravel-package",
    "license": "MIT",
    "keywords": [
        "Laravel",
        "SingPass",
        "Login",
        "MyInfo"
    ],
    "homepage": "https://github.com/accredifysg/singpass-login",
    "autoload": {
        "psr-4": {
            "Accredifysg\\SingPassLogin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Accredifysg\\SingPassLogin\\Tests\\": "tests",
            "Accredifysg\\SingPassLogin\\Database\\Factories\\": "database/factories"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/contracts": "^11.3||^12.0",
        "illuminate/database": "^11.3||^12.0",
        "illuminate/http": "^11.3||^12.0",
        "illuminate/routing": "^11.3||^12.0",
        "illuminate/support": "^11.3||^12.0",
        "web-token/jwt-framework": "^4.0.1",
        "spomky-labs/aes-key-wrap": "^7.0",
        "symfony/clock": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.4",
        "phpunit/phpunit": "^11.2",
        "laravel/pint": "^1.16",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Accredifysg\\SingPassLogin\\SingPassLoginServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/pint --parallel",
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
